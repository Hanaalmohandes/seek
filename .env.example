# Public examples only. Copy to .env if needed.
# Keep one environment active. The UI prototype does not call a backend yet.
# Never put passwords, tokens or private keys in EXPO_PUBLIC_ variables.

# Development (active example)
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000

# Staging: replace the active values above with these.
# APP_VARIANT=staging
# EXPO_PUBLIC_APP_ENV=staging
# EXPO_PUBLIC_API_URL=https://staging-api.example.com

# Production: replace the active values above with these.
# APP_VARIANT=production
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_URL=https://api.example.com
